  "comparability": {
    "group": "phs-table-3-public-capacity-v1",
    "status": "comparable_with_limitations",
    "table_title": "Health Institutions by Division, District & Tehsil, The Punjab",
    "geography_level": "district",
    "unit": "count",
    "confirmed_dimensions": [
      "The two Table 3 editions use the same district and tehsil geography for the ten pilot districts.",
      "The two tables use the same eight facility categories and separate institution and bed columns.",
      "The two tables cite the same six contributing government agencies.",
      "The snapshots are explicitly dated 01-01-2023 and 31-12-2023."
    ],
    "symbol_policy": "A printed dash is preserved as null because the source defines it as nil or insignificant; it is never silently converted to numeric zero.",
    "metric_assessments": {
      "facility_counts": {
        "status": "accepted",
        "reason": "District rows, categories, units, contributing agencies, and snapshot dates match across both Table 3 editions."
      },
      "facility_beds": {
        "status": "accepted_with_limitations",
        "reason": "The bed columns are structurally comparable, but source anomalies are retained and warned about instead of corrected."
      },
      "registered_personnel": {
        "status": "excluded",
        "reason": "Tables 5 and 6 report Punjab-wide registered personnel rather than district rows, so they cannot support district scoring."
      },
      "patient_activity": {
        "status": "pending_review",
        "reason": "Both editions contain district patient tables, but the 2023 period label is not a clear annual interval and must be resolved before temporal use."
      },
      "health_outcomes": {
        "status": "excluded",
        "reason": "The editions do not provide a general, comparable district outcome series suitable for the health score."
      }
    },
    "limitations": [
      "These values measure reported public-service capacity, not accessibility, quality, health outcomes, or causal government performance.",
      "The 2023 explanatory note appears to contain a stale reference to Punjab Health Statistics 2021; acceptance relies on the specific Table 3 title, dates, columns, and sources.",
      "The publication symbol '-' is defined as nil or insignificant and is represented as null.",
      "Counts can change because of reporting or administrative revisions as well as real capacity changes.",
      "The 2023 full file was recovered from a secondary mirror after the official site stopped listing the edition; its official URL, size, prefix bytes, cover, and table content were independently verified."
    ]
  },
