GPIS_ENV=development
GPIS_DATABASE_URL=postgresql+psycopg://gpis:gpis@localhost:5432/gpis
GPIS_REPOSITORY=postgres
GPIS_SCORE_VERSION=prototype-v1
GPIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GPIS_SEMANTIC_THRESHOLD=0.35
GPIS_SESSION_TTL_HOURS=24
LANGGRAPH_STRICT_MSGPACK=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gpis-phase-1
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=gpis-local
